---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

const resources = [
    {
        category: "Knowledge Base",
        items: [
            {
                title: "Best Practices in Modern Farming",
                description:
                    "Learn about the latest agricultural techniques and technologies.",
                link: "#",
            },
            {
                title: "Sustainable Agriculture Guide",
                description:
                    "Comprehensive guide to sustainable farming practices.",
                link: "#",
            },
        ],
    },
    {
        category: "Case Studies",
        items: [
            {
                title: "Success Stories",
                description: "Real stories from farmers using our solutions.",
                link: "#",
            },
            {
                title: "Impact Reports",
                description:
                    "Measuring our impact on agricultural communities.",
                link: "#",
            },
        ],
    },
];
---

<Layout
    title="Resources - JpGlobal"
    description="Access valuable agricultural resources, guides, and case studies to enhance your farming practices."
>
    <Navbar />

    <main class="pt-32 pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">
                Resources
            </h1>

            <div class="grid md:grid-cols-2 gap-12">
                {
                    resources.map((section) => (
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900 mb-6">
                                {section.category}
                            </h2>
                            <div class="space-y-6">
                                {section.items.map((item) => (
                                    <div class="bg-white rounded-lg shadow-md p-6">
                                        <h3 class="text-xl font-semibold text-gray-900 mb-2">
                                            {item.title}
                                        </h3>
                                        <p class="text-gray-600 mb-4">
                                            {item.description}
                                        </p>
                                        <a
                                            href={item.link}
                                            class="text-[#38bdf8] hover:text-[#38bdf8]/80 font-medium"
                                        >
                                            Learn more →
                                        </a>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </main>
</Layout>
